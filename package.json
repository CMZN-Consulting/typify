{
  "name": "typify",
  "description": "A small self-declaring language for declaring languages; the reader is an interface, not an interpreter.",
  "version": "0.4.0",
  "repository": "github:CMZN-Consulting/typify",
  "type": "module",
  "scripts": {
    "format": "prettier --write \"**/*.{md,sh,json,yml,yaml,js,ts}\" \".prettierrc\"",
    "format:check": "prettier --check \"**/*.{md,sh,json,yml,yaml,js,ts}\" \".prettierrc\"",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "check": "bun src/cli.ts check LanguageDeclarations.txt"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "prettier": "^3",
    "prettier-plugin-sh": "^0",
    "typescript": "^7.0.2"
  }
}
