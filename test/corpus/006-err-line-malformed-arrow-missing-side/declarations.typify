#lang typify

declare : KernelShapes
version : 1
is : label = /[A-Za-z0-9_:\/ >-]+/
is : node = /[a-z][a-z0-9_-]*/
is : dst = node
term : ready
term : note-line : label
term : link : node dst
form : ready!
does : ready
example : ready!
form : note-line : <label>
does : note-line <label>
example : note-line : hello : world -> arrow-inside-colon
form : <node> -> <dst>
does : link <node> <dst>
example : alpha -> beta
end!
