#lang typify

declare : ShadowedForms
version : 1
is : alpha = /[a-z]+/
is : beta = alpha
is : alnum = /[a-z0-9]+/
term : pair : alpha beta
term : first : alpha
term : second : alnum
form : pair : <alpha><beta>
does : pair <alpha> <beta>
form : pick : <alpha>
does : first <alpha>
form : pick : <alnum>
does : second <alnum>
end!
