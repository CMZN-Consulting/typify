#lang typify

declare : UntrimmedCaptureAudit
version : 1
is : item = /[a-z]+/
is : word = /[A-Za-z0-9._-]+/
is : label = word (" " word)*
term : t-item : item
term : t-label : label
form : item : [<item>]
does : t-item <item>
example : item : [a]
form : label : (<label>)
does : t-label <label>
example : label : (Daily Backup)
end!
