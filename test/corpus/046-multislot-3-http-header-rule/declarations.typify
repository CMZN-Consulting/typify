#lang typify

declare : HttpHeaderRule
version : 1
is : method = "GET" | "POST" | "DELETE"
is : hname = /[A-Za-z0-9-]+/
is : hval = /[A-Za-z0-9._\/-]+/
term : header-rule : method hname hval
form : header : [<method>] <hname> => <hval>
does : header-rule <method> <hname> <hval>
example : header : [GET] Cache-Control => no-store
end!
