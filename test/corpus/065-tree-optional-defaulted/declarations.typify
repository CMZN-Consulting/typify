#lang typify

declare : Config
version : 1
file : services/<service>/config.typify
optional!
is : service = /[a-z][a-z0-9-]*/
is : mode = "ro" | "rw"
term : access : mode
form : access : <mode>
does : access <mode>
count : access = 1
default : access : ro
example : access : rw
end!

declare : App
version : 1
file : services/<service>/app.typify
required!
sees : Config Notes
is : service = /[a-z][a-z0-9-]*/
is : word = /[a-z]+/
term : run : word
form : run : <word>
does : run <word>
count : run = 1
example : run : server
end!

declare : Notes
version : 1
file : services/<service>/notes.typify
optional!
is : service = /[a-z][a-z0-9-]*/
is : word = /[a-z]+/
term : memo : word
form : memo : <word>
does : memo <word>
count : memo = *
example : memo : todo
end!
