#lang typify

declare : Config
version : 1
is : mode = "ro" | "rw"
term : access : mode
form : access : <mode>
does : access <mode>
count : access = 1
default : access : ro
example : access : rw
end!

declare : App
version : 1
is : word = /[a-z]+/
term : run : word
form : run : <word>
does : run <word>
count : run = 1
example : run : server
end!

declare : Notes
version : 1
is : word = /[a-z]+/
term : memo : word
form : memo : <word>
does : memo <word>
count : memo = *
example : memo : todo
end!

declare : ProjectLayout
version : 1
sees : Config App Notes
is : service = /[a-z][a-z0-9-]*/
term : svc-config : service
term : svc-app : service
term : svc-notes : service
form : services/<service>/config.typify : Config
does : svc-config <service>
count : svc-config = 0..1
default : access : ro
example : services/api/config.typify : Config
form : services/<service>/app.typify : App
does : svc-app <service>
count : svc-app = 1
example : services/api/app.typify : App
form : services/<service>/notes.typify : Notes
does : svc-notes <service>
count : svc-notes = 0..1
example : services/api/notes.typify : Notes
end!
