#lang typify

declare : CatalogAsk
version : 1
is : category = "book" | "journal" | "note"
is : word = /[A-Za-z0-9-]+/
is : title = word (" " word)*
term : item : category title
form : item : <category> = <title>
does : item <category> <title>
count : item = 1..*
example : item : book = Types and Programming Languages
end!
