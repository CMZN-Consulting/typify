#lang typify

declare : DefaultFormLine
version : 1
is : mode = "ro" | "rw"
is : name = /[a-z]+/
term : access : mode
term : target : name
form : access : <mode>
does : access <mode>
count : access = 0..1
default : access : ro
example : access : rw
form : target : <name>
does : target <name>
count : target = 1
example : target : archive
end!
