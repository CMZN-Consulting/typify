#lang typify

declare : Catalog
version : 1
is : category = "book" | "journal" | "note"
is : word = /[A-Za-z0-9-]+/
is : title = word (" " word)*
term : item : category title
form : item : <category> = <title>
does : item <category> <title>
example : item : book = Structure and Interpretation of Computer Programs
end!
