#lang typify

declare : ModeJoin
version : 1
is : path = canonical-path
is : mode = "ro" | "rw"
primitive : grant-mode : path mode
writes : grant-mode : perms = put 1
cell : perms = join modes
join : modes : "ro" "rw" = "rw"
form : grant : <path> <mode>
does : grant-mode <path> <mode>
example : grant : /mounts/shared ro
end!
