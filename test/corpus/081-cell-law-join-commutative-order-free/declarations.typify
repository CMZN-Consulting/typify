#lang typify

declare : ModeJoin
version : 1
is : path = canonical-path
is : mode = "ro" | "rw"
term : grant-mode : path mode
primitive!
writes : grant-mode : perms = put 1
cell : perms = join modes
join : modes : "ro" "ro" = "ro"
join : modes : "ro" "rw" = "rw"
join : modes : "rw" "rw" = "rw"
form : grant : <path> <mode>
does : grant-mode <path> <mode>
example : grant : /mounts/shared ro
rule : grant-mode <p> <m> -> grant-mode <p> <m>
end!
