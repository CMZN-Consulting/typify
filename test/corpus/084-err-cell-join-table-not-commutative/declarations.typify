#lang typify

declare : BadJoinConflictingPair
version : 1
is : key = /[a-z]+/
is : mode = "ro" | "rw"
primitive : set-mode : key mode
writes : set-mode : perms = put 1
cell : perms = join bad_modes
join : bad_modes : "ro" "rw" = "rw"
join : bad_modes : "rw" "ro" = "ro"
form : mode : <key> <mode>
does : set-mode <key> <mode>
example : mode : app ro
end!
