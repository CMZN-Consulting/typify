#lang typify

declare : ExternalPrimitivePlan
version : 1
is : path = canonical-path
term : mask : path
primitive!
writes : mask : mounts = put 1
cell : mounts = shadow stacking
term : spawn : path
primitive!
effect : spawn = external
form : mask : <path>
does : mask <path>
example : mask : /mounts/work
form : spawn : <path>
does : spawn <path>
example : spawn : /usr/bin/sync
rule : (mask <p>) -> (mask <p>)
rule : (spawn <p>) -> (spawn <p>)
end!
