#lang typify

declare : LibraryErrors
version : 1
is : seg = /[a-z0-9._-]+/ except "." | ".."
is : path = "/" | ("/" seg)+
is : base = path
is : rel = path
primitive : touch : path
writes : touch : fs = put 1
cell : fs = shadow
term : touch-parent : path
term : touch-join : path path
form : touch-parent : <path>
does : touch-parent <path>
example : touch-parent : /mounts/sub
form : touch-join : <base> <rel>
does : touch-join <base> <rel>
example : touch-join : /mounts /sub
rule : touch-parent <p> -> touch (parent <p>)
rule : touch-join <a> <b> -> touch (join <a> <b>)
end!
