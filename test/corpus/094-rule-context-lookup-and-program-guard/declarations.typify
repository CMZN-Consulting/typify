#lang typify

declare : RootConfig
version : 1
file : root.typify
required!
is : path = canonical-path
term : base-dir : path
form : base-dir : <path>
does : base-dir <path>
count : base-dir = 1
example : base-dir : /mounts/root
end!

declare : ServiceMount
version : 1
file : services/<svc>/mounts.typify
required!
sees : RootConfig
is : svc = /[a-z][a-z0-9-]*/
is : seg = /[a-z0-9._-]+/ except "." | ".."
is : path = "/" | ("/" seg)+
primitive : bind : svc path path
writes : bind : mounts = put 2
cell : mounts = shadow stacking
term : mount-rel : path seg
guard : mount-rel = exists
form : mount-rel : <path> <seg>
does : mount-rel <path> <seg>
example : mount-rel : /mounts/root cache
rule : mount-rel <g> <s> -> bind <svc> (join (context base-dir) <s>) (join (context base-dir) <s>)
end!
