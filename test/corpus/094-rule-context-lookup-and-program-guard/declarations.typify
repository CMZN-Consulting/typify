#lang typify

declare : RootConfig
version : 1
is : path = canonical-path
term : base-dir : path
fact : base-dir
scope : base-dir = root
form : base-dir : <path>
does : base-dir <path>
count : base-dir = 1
example : base-dir : /mounts/root
end!

declare : ServiceMount
version : 1
is : seg = /[a-z0-9._-]+/ except "." | ".."
is : path = canonical-path
term : bind : path path
primitive!
writes : bind : mounts = put 1
cell : mounts = shadow stacking
term : mount-rel : seg
guard : mount-rel = (exists (context base-dir))
form : mount-rel : <seg>
does : mount-rel <seg>
example : mount-rel : cache
rule : (mount-rel <s>) -> (bind (join (context base-dir) <s>) (join (context base-dir) <s>))
end!

declare : RootTreePlan
version : 1
sees : RootConfig ServiceMount
is : svc = /[a-z][a-z0-9-]*/
term : root-cfg :
term : svc-mnt : svc
form : root.typify : RootConfig
does : root-cfg
count : root-cfg = 1
example : root.typify : RootConfig
form : services/<svc>/mounts.typify : ServiceMount
does : svc-mnt <svc>
count : svc-mnt = 1..*
example : services/api/mounts.typify : ServiceMount
end!
