#lang typify

declare : MissingActionForConstructor
version : 1
is : word = /[a-z]+/
primitive : prim-op : word
writes : prim-op : log = put 1
cell : log = shadow
term : unhandled : word
form : prim : <word>
does : prim-op <word>
example : prim : alpha
form : unhandled : <word>
does : unhandled <word>
example : unhandled : beta
end!
