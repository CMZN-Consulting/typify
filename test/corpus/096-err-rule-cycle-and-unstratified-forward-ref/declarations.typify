#lang typify

declare : CyclicRules
version : 1
is : word = /[a-z]+/
primitive : prim : word
writes : prim : out = put 1
cell : out = shadow
term : alpha : word
term : beta : word
form : prim : <word>
does : prim <word>
example : prim : zero
form : alpha : <word>
does : alpha <word>
example : alpha : one
form : beta : <word>
does : beta <word>
example : beta : two
rule : alpha <x> -> beta <x>
rule : beta <x> -> alpha <x>
end!
