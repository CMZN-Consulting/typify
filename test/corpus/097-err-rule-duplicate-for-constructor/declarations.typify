#lang typify

declare : DuplicateRule
version : 1
is : word = /[a-z]+/
primitive : prim : word
writes : prim : out = put 1
cell : out = shadow
term : action : word
form : prim : <word>
does : prim <word>
example : prim : zero
form : action : <word>
does : action <word>
example : action : one
rule : action <x> -> prim <x>
rule : action <x> -> prim <x> ; prim <x>
end!
