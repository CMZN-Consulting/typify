#lang typify

declare : NonVarRuleLHS
version : 1
is : word = /[a-z]+/
primitive : prim : word
writes : prim : out = put 1
cell : out = shadow
term : action : word
term : pair-act : word
form : prim : <word>
does : prim <word>
example : prim : zero
form : action : <word>
does : action <word>
example : action : one
form : pair-act : <word>
does : pair-act <word>
example : pair-act : two
rule : action "literal" -> prim "literal"
rule : pair-act <x> <y> -> prim <x>
end!
